#!/usr/bin/env python3
"""CUPS backend that sends print data to the LabelWriter's USB device.

It takes the same lock as the add-on's own printing, so jobs from network
clients and from Home Assistant never interleave. Device URI: dymo:/dev/usb/lp0
Installed as /usr/lib/cups/backend/dymo with mode 0700, so CUPS runs it as root.
"""

import fcntl
import os
import shutil
import sys

LOCK_FILE = os.environ.get("DYMO_LOCK_FILE", "/run/dymo-labels.lock")
# CUPS backend exit codes.
OK, FAILED, RETRY = 0, 1, 6


def main() -> int:
    if len(sys.argv) == 1:
        # Device discovery by lpinfo: nothing to discover, the URI is set explicitly.
        print('direct dymo "Unknown" "DYMO LabelWriter (Home Assistant add-on)"')
        return OK
    if len(sys.argv) not in (6, 7):
        print("Usage: dymo job-id user title copies options [file]", file=sys.stderr)
        return FAILED

    device = os.environ.get("DEVICE_URI", "dymo:/dev/usb/lp0").split(":", 1)[1] or "/dev/usb/lp0"
    # With a file argument the backend is responsible for copies; from stdin the filters handled them.
    copies = max(1, int(sys.argv[4])) if len(sys.argv) == 7 else 1
    try:
        with open(LOCK_FILE, "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            with open(device, "wb", buffering=0) as printer:
                for _ in range(copies):
                    if len(sys.argv) == 7:
                        with open(sys.argv[6], "rb") as data:
                            shutil.copyfileobj(data, printer)
                    else:
                        shutil.copyfileobj(sys.stdin.buffer, printer)
    except FileNotFoundError:
        print(f"ERROR: USB printer device does not exist: {device}", file=sys.stderr)
        return RETRY
    except OSError as exc:
        print(f"ERROR: Could not write to {device}: {exc}", file=sys.stderr)
        return RETRY
    return OK


if __name__ == "__main__":
    sys.exit(main())
